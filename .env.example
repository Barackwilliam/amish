SECRET_KEY=badilisha-hii
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase: Project Settings > Database > Connection string (URI), tumia pooler ya 6543
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres
MEDIA_ROOT=media

# Picha: "local" kwa disk ya Render, au "s3" kwa Supabase Storage
MEDIA_STORAGE=local
# Supabase: Project Settings > Storage > S3 access keys
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=media
# S3_REGION=us-east-1
# Email za kutuma taarifa ya ujumbe mpya
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@amish.co.tz
ENQUIRY_NOTIFY_EMAIL=info@amish.co.tz
